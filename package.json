{
  "name": "huey-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "reader"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @huey/reader",
    "build": "npm run build --workspace @huey/reader",
    "preview": "npm run preview --workspace @huey/reader",
    "test": "node --test reader/tests/*.test.mjs",
    "test:model": "npm run model:check && node --test tests/literary-model.test.mjs",
    "model:check": "node scripts/literary_model.mjs",
    "content": "node reader/scripts/content.mjs",
    "book:check": "python3 scripts/book.py validate",
    "book:list": "python3 scripts/book.py list",
    "book:count": "python3 scripts/book.py count",
    "book:md": "python3 scripts/book.py emit",
    "inventory:check": "node scripts/editorial_inventory.mjs check",
    "inventory:emit": "node scripts/editorial_inventory.mjs emit",
    "test:inventory": "npm run inventory:check && node --test tests/editorial-inventory.test.mjs"
  }
}
